# AMD Llano K10 + BORE Tuned Configuration
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_X86=y
CONFIG_INSTRUCTION_DECODER=y
CONFIG_OUTPUT_FORMAT="elf64-x86-64"
CONFIG_ARCH_DEFCONFIG="arch/x86/configs/x86_64_defconfig"

# CPU Model: AMD K10 / Llano Microarchitecture
CONFIG_MAMDFAM10=y
CONFIG_GENERIC_CPU=n
CONFIG_X86_INTERNODE_CACHE_SHIFT=6
CONFIG_X86_L1_CACHE_SHIFT=6
CONFIG_X86_TSC=y
CONFIG_X86_CMPXCHG64=y
CONFIG_X86_CMOV=y
CONFIG_X86_MINIMUM_CPU_FAMILY=64
CONFIG_CPU_SUP_AMD=y

# Desktop Interactivity & Low Latency
CONFIG_PREEMPT_BUILD=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_COUNT=y
CONFIG_PREEMPTION=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_SCHED_BORE=y

# Memory Management & ZSWAP (Crucial for 3.3GB RAM)
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y
CONFIG_ZSWAP_ZPOOL_DEFAULT_Z3FOLD=y
CONFIG_ZRAM=m
CONFIG_ZRAM_DEF_COMP_LZ4=y

# Essential Drivers for Laptop Hardware
CONFIG_DRM_RADEON=y
CONFIG_R8169=y
CONFIG_SND_HDA_INTEL=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_I2C_PIIX4=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_SP5100_TCO=m
CONFIG_RTS5209_PCI=m
